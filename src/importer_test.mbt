///|
test "sanitize_stem : 空串/数字开头/大写/中文" {
  inspect(@src.sanitize_stem(""), content="x")
  inspect(@src.sanitize_stem("9x"), content="x_9x")
  inspect(@src.sanitize_stem("Config"), content="config")
  inspect(@src.sanitize_stem("配置"), content="配置")
}

///|
test "issue #4 防回归 : 跨文件撞名 stem 前缀（同目录后来者）" {
  let a = do_import("{\"entries\":[{\"code\":1,\"title\":\"a\"}]}", stem="a")
  // taken_names 模拟同目录已存在 a.json.mbt（其 struct 名 A/Code）
  let b = @src.import_source(
    "{\"payloads\":[{\"code\":1,\"title\":\"a\"}]}",
    path="b.json",
    stem="b",
    taken_names=["A", "Code"],
  )
  inspect(a.contains("pub struct Code"), content="true") // 先到者零变化
  inspect(b.content.contains("pub struct BCode"), content="true") // 后来者前缀
  let _ = @src.build_source(b.content, path="b.json.mbt", expected_name="b") // 回吃合法
}

///|
test "审 P2-1 : 保留字 stem 清洗（test.json 等 15/16 实测中招）" {
  inspect(@src.sanitize_stem("test"), content="x_test")
  inspect(@src.sanitize_stem("type"), content="x_type")
  inspect(@src.sanitize_stem("match"), content="x_match")
  inspect(@src.sanitize_stem("view"), content="view") // 非保留字零变化
  // 端到端：保留字文件名 import → 产物合法可回吃
  let out = do_import("{\"k\":1}", stem="test")
  let _ = @src.build_source(out, path="t.json.mbt", expected_name="x_test")
}

///|
test "§8 裁定 : 无参构造器字面量（enum 投影 + 拼错变体 jsonmbt 侧红）" {
  let src =
    #|enum Severity {
    #|  E1001_UnknownChar
    #|  E1002_UnterminatedString
    #|}
    #|struct Entry {
    #|  sev : Severity
    #|}
    #|
    #|pub let entry : Entry = Entry::{
    #|  sev: E1001_UnknownChar,
    #|}
  let out = @src.build_source(src, path="entry.json.mbt", expected_name="entry")
  inspect(out, content="{\"sev\":\"E1001_UnknownChar\"}")
  // 拼错变体：jsonmbt 自持校验写时红（防线补位 moon [4031]）
  let d = try {
    let _ = @src.build_source(
      src.replace(old="E1001_UnknownChar,", new="E1001_UnknownCharX,"),
      path="entry.json.mbt",
      expected_name="entry",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(
    d.contains("enum 'Severity' has no variant 'E1001_UnknownCharX'"),
    content="true",
  )
}

///|
test "§8 裁定 : #| 多行字符串（行净内容 \n 连接 + 类型错位红）" {
  let src =
    #|struct Note {
    #|  body : String
    #|  n : Int
    #|}
    #|
    #|pub let note : Note = Note::{
    #|  body: #|第一行说明
    #|#|第二行说明
    #|,
    #|  n: 1,
    #|}
  let out = @src.build_source(src, path="note.json.mbt", expected_name="note")
  inspect(
    out,
    content="{\"body\":\"第一行说明\\n第二行说明\",\"n\":1}",
  )
  // 类型错位（Int 字段给多行字符串）→ J3004
  let d = try {
    let _ = @src.build_source(
      src.replace(old="n : Int", new="n : Bool"),
      path="note.json.mbt",
      expected_name="note",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J3004]"), content="true")
}

///|
test "D-5 转正 : 带 payload 构造器——tag 对象展开（标量/struct 双形态 + 拼错红）" {
  // 标量 payload：E(3032) → {"case":"E","value":3032}
  let scalar =
    #|enum Sev {
    #|  E(Int)
    #|}
    #|struct T {
    #|  s : Sev
    #|}
    #|
    #|pub let t : T = T::{
    #|  s: E(3032),
    #|}
  inspect(
    @src.build_source(scalar, path="t.json.mbt", expected_name="t"),
    content="{\"s\":{\"case\":\"E\",\"value\":3032}}",
  )
  // struct payload：tag + 字段展开进顶层（vm_digest 建模原型）
  let doc =
    #|enum Case {
    #|  Standard(Std)
    #|  CompileFail(Fail)
    #|}
    #|pub struct Std {
    #|  src_sha : String
    #|  exit_code : Int
    #|}
    #|pub struct Fail {
    #|  src_sha : String
    #|  compile_fail : Bool
    #|}
    #|struct Digest {
    #|  cases : Map[String, Case]
    #|}
    #|
    #|pub let digest : Digest = Digest::{
    #|  cases: {
    #|    "a.c": Standard(Std::{ src_sha: "s1", exit_code: 0 }),
    #|    "b.c": CompileFail(Fail::{ src_sha: "s2", compile_fail: true }),
    #|  },
    #|}
  inspect(
    @src.build_source(doc, path="digest.json.mbt", expected_name="digest"),
    content="{\"cases\":{\"a.c\":{\"case\":\"Standard\",\"src_sha\":\"s1\",\"exit_code\":0},\"b.c\":{\"case\":\"CompileFail\",\"src_sha\":\"s2\",\"compile_fail\":true}}}",
  )
  // 拼错 payload 变体 → J3004（自持防线）
  let d = try {
    let _ = @src.build_source(
      scalar.replace(old="E(3032)", new="Y(3032)"),
      path="t.json.mbt",
      expected_name="t",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("no payload variant 'Y'"), content="true")
}

///|
test "D-5 转正边界 : tag 键冲突拒（J3008）+ 无上下文裸构造器拒 + import 不自动转" {
  // payload struct 含 case 字段 → J3008（规格：撞车显式拒，不静默覆盖）
  let coll =
    #|enum C {
    #|  X(P)
    #|}
    #|pub struct P {
    #|  case : String
    #|}
    #|struct T {
    #|  c : C
    #|}
    #|
    #|pub let t : T = T::{
    #|  c: X(P::{ case: "a" }),
    #|}
  let d = try {
    let _ = @src.build_source(coll, path="t.json.mbt", expected_name="t")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J3008]"), content="true")
  // 裸构造器无类型上下文：语义不明保守拒（保持）
  let d2 = try {
    let _ = @src.build_source(
      "pub let t = VerifiedRun",
      path="t.json.mbt",
      expected_name="t",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d2.contains("[J3001]"), content="true")
  // import 不自动转（D-5 规格边界）：缺键异构数组仍拒——拼错字段名与真
  // 可选无法区分 + 自动推断会把数据错误静默类型化（fail loud 纪律）
  let d3 = try {
    let _ = @src.import_source(
      "[{\"a\":1},{\"a\":2,\"b\":3}]",
      path="x.json",
      stem="x",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d3.contains("[J4010]"), content="true")
}

///|
test "import : 保留字字段名改名 where_ + field-alias 注记 + 往返等价（#13）" {
  // 触发条件（issue 实测）：字段名 where（MoonBit 保留字）+ 同层兄弟字段。
  // 现行 = 整对象退 Map 逃生门 → 兄弟值异型统一失败 → 误导性 J4011；
  // 修复后 = struct 照出（where 改名 where_，原始键走 field-alias 注记）
  let json = "{\"a\": [{\"where\": \"x\", \"b\": [\"t\"]}]}"
  let out = do_import(json, stem="w")
  inspect(
    out,
    content="// @generated by jsonmbt import —— 禁手改（再生成：jsonmbt import t.json）。\n// 源：t.json\n// jsonmbt: field-alias Where.where_ = \"where\"\n\npub struct W {\n  a : Array[Where]\n}\n\npub struct Where {\n  where_ : String\n  b : Array[String]\n}\n\npub let w : W = W::{\n  a: [Where::{ where_: \"x\", b: [\"t\"] }],\n}\n",
  )
  // 往返：build 侧按注记还原 JSON 键（where_ → where）
  let built = @src.build_source(out, path="w.json.mbt", expected_name="w")
  inspect(built, content="{\"a\":[{\"where\":\"x\",\"b\":[\"t\"]}]}")
}

///|
test "import : 保留字改名与原生尾下划线键共存（撞名两级下划线，#13）" {
  // where → where_，原生 where_ 被顶到 where__——双注记，往返无损
  let json = "{\"where\": 1, \"where_\": 2}"
  let out = do_import(json, stem="w")
  inspect(
    out.contains("where_ : Int") && out.contains("where__ : Int"),
    content="true",
  )
  inspect(
    out.contains("// jsonmbt: field-alias W.where_ = \"where\"") &&
    out.contains("// jsonmbt: field-alias W.where__ = \"where_\""),
    content="true",
  )
  let built = @src.build_source(out, path="w.json.mbt", expected_name="w")
  inspect(built, content="{\"where\":1,\"where_\":2}")
}

///|
test "import : 非可改名非法键的 Map 逃生门失败须点名键因（#13 文案）" {
  // 点号键不可改名（本批范围外）→ 仍走 Map 逃生门；但失败文案必须点名
  // 「键不是合法字段名」这个真因，不得再报误导性的跨样本类型冲突
  let d = try {
    let _ = do_import("{\"a.b\": \"x\", \"c\": [\"t\"]}")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J4011]"), content="true")
  inspect(
    d.contains("'a.b'") && d.contains("not legal MoonBit field labels"),
    content="true",
  )
}

///|
test "import : J4010 键集分布按容器路径分组（#14-3）" {
  // 顶层 doc 与嵌套 schema 是单样本（无漂移），真漂移在 $.entries[]——
  // 报告按容器分组，顶层键集不再与数组元素混计
  let d = try {
    let _ = do_import(
      "{\"doc\": {\"schema\": 1}, \"entries\": [{\"a\": 1, \"b\": 2}, {\"a\": 1, \"c\": 3}]}",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d.contains("[J4010]"), content="true")
  inspect(d.contains("at $.entries[]"), content="true")
  inspect(d.contains("2 distinct key sets in 2 samples"), content="true")
  inspect(d.contains("{ doc, entries }"), content="false")
}

///|
test "build : field-alias 注记的解析与校验（J3009 家族，#13）" {
  // 手写文件带注记：build 侧应用逆映射（手写保留字键对象首次可表达）
  let doc =
    #|// jsonmbt: field-alias Rule.where_ = "where"
    #|struct Rule {
    #|  where_ : String
    #|}
    #|
    #|pub let r : Rule = Rule::{
    #|  where_: "x",
    #|}
  inspect(
    @src.build_source(doc, path="r.json.mbt", expected_name="r"),
    content="{\"where\":\"x\"}",
  )
  // 注记指向不存在的 struct → J3009
  let bad1 = try {
    let _ = @src.build_source(
      doc.replace(old="Rule.where_", new="Nope.where_"),
      path="r.json.mbt",
      expected_name="r",
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(bad1.contains("[J3009]"), content="true")
  // 恒等注记（键 == 字段名）→ J3009（无意义注记拒收，防手滑）
  let idoc =
    #|// jsonmbt: field-alias Rule.k = "k"
    #|struct Rule {
    #|  k : String
    #|}
    #|
    #|pub let r : Rule = Rule::{
    #|  k: "x",
    #|}
  let bad2 = try {
    let _ = @src.build_source(idoc, path="r.json.mbt", expected_name="r")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(bad2.contains("[J3009]"), content="true")
  // 畸形注记行（语法不完整）→ J3009
  let mdoc =
    #|// jsonmbt: field-alias Rule.where_
    #|struct Rule {
    #|  where_ : String
    #|}
    #|
    #|pub let r : Rule = Rule::{
    #|  where_: "x",
    #|}
  let bad3 = try {
    let _ = @src.build_source(mdoc, path="r.json.mbt", expected_name="r")
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(bad3.contains("[J3009]"), content="true")
}

///|
test "import : Map 值类型命名改宿主键派生（#6-4）" {
  // 现状（issue 评论拍板采纳）：Map 值组名取首字段派生——cases 的值是
  // 4 字段 digest 条目却叫 Src_sha（误导）；改宿主键派生 cases → CasesEntry
  let json = "{\"cases\": {\"a.c\": {\"src_sha\": \"s1\", \"exit_code\": 0}, \"b.c\": {\"src_sha\": \"s2\", \"exit_code\": 1}}}"
  let out = do_import(json)
  inspect(out.contains("pub struct CasesEntry"), content="true")
  inspect(out.contains("Map[String, CasesEntry]"), content="true")
  inspect(out.contains("pub struct Src_sha"), content="false")
  // 往返：键序 = 源序（cases/a.c/b.c），值无损
  let built = @src.build_source(out, path="t.json.mbt")
  inspect(
    built,
    content="{\"cases\":{\"a.c\":{\"src_sha\":\"s1\",\"exit_code\":0},\"b.c\":{\"src_sha\":\"s2\",\"exit_code\":1}}}",
  )
}

///|
test "import : --type-name-map 语义命名（#6-4）" {
  // 机器派生名（Id/File2 等）零信息量——映射表给人起名的入口；
  // 键 = 派生名（用户从首次 import 产物里看到的），值 = 语义名
  let json = "{\"items\": [{\"id\": 1, \"file\": \"x\"}]}"
  let map : Map[String, String] = { "Id": "Entry" }
  let outcome = @src.import_source(
    json,
    path="t.json",
    stem="t",
    type_name_map=map,
  )
  inspect(outcome.content.contains("pub struct Entry"), content="true")
  inspect(outcome.content.contains("pub struct Id"), content="false")
  inspect(
    outcome.content.contains("Entry::{ id: 1, file: \"x\" }"),
    content="true",
  )
  // 命中的映射键不出现在 unmatched
  inspect(outcome.unmatched.length(), content="0")
  // 往返等价
  let built = @src.build_source(outcome.content, path="t.json.mbt")
  inspect(built, content="{\"items\":[{\"id\":1,\"file\":\"x\"}]}")
}

///|
test "import : --type-name-map 未命中键不阻断（hint 面，#6-4）" {
  let map : Map[String, String] = { "Id": "Entry", "Nope": "X" }
  let outcome = @src.import_source(
    "{\"items\": [{\"id\": 1, \"file\": \"x\"}]}",
    path="t.json",
    stem="t",
    type_name_map=map,
  )
  inspect(outcome.unmatched.length(), content="1")
  inspect(outcome.unmatched.contains("Nope"), content="true")
}

///|
test "import : --type-name-map 语义错拒绝（J1010，#6-4）" {
  // 值非法类型名（小写开头）
  let d1 = try {
    let _ = @src.import_source(
      "{\"items\": [{\"id\": 1}]}",
      path="t.json",
      stem="t",
      type_name_map={ "Id": "entry" },
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d1.contains("[J1010]"), content="true")
  // 值与顶层 struct 名撞车（stem 派生 T 已占）
  let d2 = try {
    let _ = @src.import_source(
      "{\"items\": [{\"id\": 1}]}",
      path="t.json",
      stem="t",
      type_name_map={ "Id": "T" },
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d2.contains("[J1010]"), content="true")
}

///|
test "D-5 嵌套 enum payload：payload 类型是 enum 名时须 resolve（审阅 P2）" {
  // 带参构造器的形参类型为 enum 名：parse_type 产 JTStruct，查表分化
  // 需要 resolve_custom——root/struct 字段侧都 resolve，唯 payload 漏
  // （修复前：合法输入误报 J3004 expects Col, got enum variant 'X'）
  let doc =
    #|enum Col {
    #|  X
    #|}
    #|enum Field {
    #|  Named(Col)
    #|}
    #|struct T {
    #|  f : Field
    #|}
    #|
    #|pub let t : T = T::{
    #|  f: Named(X),
    #|}
  inspect(
    @src.build_source(doc, path="t.json.mbt", expected_name="t"),
    content="{\"f\":{\"case\":\"Named\",\"value\":\"X\"}}",
  )
  // struct payload 形参（既有锚已盖）不受影响：名在 struct 表命中，
  // resolve_custom 原样透传
  let doc2 =
    #|struct P {
    #|  v : Int
    #|}
    #|enum E {
    #|  Tag(P)
    #|}
    #|pub let e : E = Tag(P::{ v: 7 })
  inspect(
    @src.build_source(doc2, path="e.json.mbt", expected_name="e"),
    content="{\"case\":\"Tag\",\"v\":7}",
  )
}

///|
test "import : 空容器 Never 占位默认产出（#14-2a）——J4001/J4002 不再整张拒" {
  // 孤立空数组 → Array[Never] + Never 定义 + rc-0 占位 hint + 往返无损
  let o1 = @src.import_source("{\"exemptions\": []}", path="t.json", stem="t")
  inspect(o1.content.contains("pub enum Never {}"), content="true")
  inspect(o1.content.contains("exemptions : Array[Never]"), content="true")
  inspect(o1.hints.length() >= 1, content="true")
  inspect(o1.hints[0].render().contains("Array[Never]"), content="true")
  inspect(
    @src.build_source(o1.content, path="t.json.mbt"),
    content="{\"exemptions\":[]}",
  )
  // 空对象 → Map[String, Never]
  let o2 = @src.import_source("{\"cfg\": {}}", path="t.json", stem="t")
  inspect(o2.content.contains("cfg : Map[String, Never]"), content="true")
  inspect(
    @src.build_source(o2.content, path="t.json.mbt"),
    content="{\"cfg\":{}}",
  )
  // 顶层空数组 → pub let t : Array[Never] = []
  let o3 = @src.import_source("[]", path="t.json", stem="t")
  inspect(o3.content.contains("pub let t : Array[Never] = []"), content="true")
  inspect(@src.build_source(o3.content, path="t.json.mbt"), content="[]")
  // 两级启发优先级保持：同文件他处同名非空字段给出精确类型（D-1 主路径）
  let o4 = @src.import_source(
    "{\"list\": [], \"nested\": {\"list\": [1, 2]}}",
    path="t.json",
    stem="t",
  )
  inspect(o4.content.contains("Array[Int]"), content="true")
  inspect(o4.content.contains("Never"), content="false")
  // Never 预留：元素对象首键 never 会派生组名 Never——预留迫其去重（Never2）
  let o5 = @src.import_source(
    "{\"items\": [{\"never\": 1}]}",
    path="t.json",
    stem="t",
  )
  // 无空容器 → 无 Never 定义；预留生效 → 派生名不是 Never（Never2 兜底）
  inspect(
    o5.content.split("pub enum Never").length() == 1 &&
    !o5.content.contains("pub struct Never {"),
    content="true",
  )
  inspect(o5.content.contains("pub struct Never2"), content="true")
}

///|
test "import : --strict 恢复空容器拒绝（#14-2a——严格档反向 opt-in）" {
  let d1 = try {
    let _ = @src.import_source(
      "{\"exemptions\": []}",
      path="t.json",
      stem="t",
      strict=true,
    )
    "SUCCEEDED"
