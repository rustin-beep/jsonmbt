  }
  inspect(d1.contains("[J4001]"), content="true")
  let d2 = try {
    let _ = @src.import_source(
      "{\"cfg\": {}}",
      path="t.json",
      stem="t",
      strict=true,
    )
    "SUCCEEDED"
  } catch {
    e => if e is @src.Diag(..) { e.render() } else { abort("non-Diag") }
  }
  inspect(d2.contains("[J4002]"), content="true")
}
